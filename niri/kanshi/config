# kanshi — dynamic output profiles for niri on hopper
# docked: GN34CW ultrawide only, laptop panel off.
# mobile: laptop panel only (GN34CW unplugged).
# Each profile also sets the matching wallpaper via swaybg.

profile docked {
    output HDMI-A-2 enable mode 3440x1440 position 0,0 scale 1
    output eDP-1 disable
    exec pkill -x swaybg; swaybg -i /home/entropy/pictures/wallpapers/miles_glitch_ultrawide.png -m fill &
}

profile mobile {
    output eDP-1 enable mode 2736x1824 position 0,0 scale 2
    exec pkill -x swaybg; swaybg -i /home/entropy/pictures/wallpapers/miles_glitch.jpeg -m fill &
}
