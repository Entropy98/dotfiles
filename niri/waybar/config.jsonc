{
    // Waybar 0.15.0 (built from source) — native niri modules available.
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,

    // niri/workspaces can't show per-window icons — window-rewrite is a
    // hyprland-only feature — so the workspace buttons are custom modules fed by
    // scripts/niri-ws-icons.sh, one per workspace index. Indices that don't
    // exist print empty text and waybar hides them, so buttons appear and
    // vanish as niri creates and reaps workspaces. Bump this list past 6 if you
    // ever run more. custom/niri-ws-watch draws nothing: it tails niri's event
    // stream and sends SIGRTMIN+8 to keep the buttons live.
    "modules-left": [
        "custom/niri-ws-watch",
        "custom/ws1", "custom/ws2", "custom/ws3",
        "custom/ws4", "custom/ws5", "custom/ws6",
        "niri/window"
    ],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "pulseaudio", "network", "battery", "tray"],

    "custom/niri-ws-watch": {
        "exec": "$HOME/.config/waybar/scripts/niri-ws-watch.sh",
        "tooltip": false
    },

    "custom/ws1": {
        "exec": "$HOME/.config/waybar/scripts/niri-ws-icons.sh 1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "niri msg action focus-workspace 1",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "custom/ws2": {
        "exec": "$HOME/.config/waybar/scripts/niri-ws-icons.sh 2",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "niri msg action focus-workspace 2",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "custom/ws3": {
        "exec": "$HOME/.config/waybar/scripts/niri-ws-icons.sh 3",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "niri msg action focus-workspace 3",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "custom/ws4": {
        "exec": "$HOME/.config/waybar/scripts/niri-ws-icons.sh 4",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "niri msg action focus-workspace 4",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "custom/ws5": {
        "exec": "$HOME/.config/waybar/scripts/niri-ws-icons.sh 5",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "niri msg action focus-workspace 5",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "custom/ws6": {
        "exec": "$HOME/.config/waybar/scripts/niri-ws-icons.sh 6",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "niri msg action focus-workspace 6",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        "tooltip": false
    },

    "mpris": {
        // libplayerctl parses the reverse-DNS bus name (io.github.lullabyX.sone)
        // and keeps only the first segment as the player name, so the mpris
        // module matches on "io", not the full app id. See instance= in the
        // busctl on-click commands below for the real D-Bus name.
        "player": "io",
        "format": "{status_icon} {artist} – {title}",
        "format-paused": "{status_icon} {artist} – {title}",
        "status-icons": { "playing": "", "paused": "" },
        "max-length": 50,
        "tooltip-format": "{album}\n{artist} – {title}",
        "on-click": "busctl --user call org.mpris.MediaPlayer2.io.github.lullabyX.sone /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player PlayPause",
        "on-scroll-up": "busctl --user call org.mpris.MediaPlayer2.io.github.lullabyX.sone /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Next",
        "on-scroll-down": "busctl --user call org.mpris.MediaPlayer2.io.github.lullabyX.sone /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Previous"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ifname} ",
        "format-disconnected": "offline ",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "muted ",
        "format-icons": { "default": ["", ""] },
        "on-click": "pavucontrol"
    },

    "tray": {
        "spacing": 8
    }
}
